{
  "name": "zhixing-study-app",
  "version": "1.3.3",
  "description": "知行研学课程、活动与研学方案设计应用",
  "private": true,
  "type": "module",
  "main": "desktop/main.mjs",
  "scripts": {
    "start": "node server.mjs",
    "preview": "node server.mjs",
    "desktop": "electron .",
    "dist:win": "electron-builder --win nsis --x64",
    "dev": "netlify dev",
    "build:site": "node scripts/prepare-site.mjs",
    "deploy": "npm run build:site && netlify deploy --prod",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "@netlify/blobs": "latest",
    "@netlify/database": "latest",
    "@neondatabase/serverless": "latest",
    "pg": "latest"
  },
  "devDependencies": {
    "electron": "latest",
    "electron-builder": "latest"
  },
  "build": {
    "appId": "com.zhixing.study",
    "productName": "知行研学",
    "asar": true,
    "directories": {
      "output": "release/desktop"
    },
    "files": [
      "desktop/**/*",
      "build/icon.png",
      "server.mjs",
      "index.html",
      "course-designer.html",
      "download.html",
      "admin.html",
      "privacy.html",
      "manifest.json",
      "favicon.png",
      "favicon.svg",
      "sw.js",
      "assets/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ],
      "icon": "build/icon.png",
      "artifactName": "Zhixing-Study-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "知行研学",
      "installerLanguages": ["zh_CN"],
      "language": "2052"
    }
  },
  "engines": {
    "node": ">=22"
  }
}
